#Configuracion de la base de datos POSTGRESQL
POSTGRESQL_PORT=5432
POSTGRESQL_NAME=erp-postgres
POSTGRESQL_DB=erp_db
POSTGRESQL_USER=cjava
POSTGRESQL_PASSWORD=secret

#Configuracion de la base de datos MONGODB
MONGODB_PORT=27017
MONGODB_NAME=erp-mongo
MONGODB_DB=venta_db
MONGODB_USER=cjava
MONGODB_PASSWORD=secret

#Configuracion de Discovery Service
DISCOVERY_SERVICE_HOST=localhost
DISCOVERY_SERVICE_PORT=8761
DISCOVERY_SERVICE_PROFILE=server01

#Configuracion de Configuracion Server
CONFI_SERVER_HOST=localhost
CONFI_SERVER_PORT=9000
CONFI_SERVER_URI=https://github.com/RobinUnfv/session4.git
CONFI_SERVER_BRANCH=develop
CONFI_SERVER_PROFILE=dev

#Configuracion de Cliente Service
MSVC_CLIENTE_PORT=7010

#Configuracion de Compras
MSVC_COMPRAS_PORT=7020

#Configuracion de Cloud Gateway
CLOUD_GATEWAY_PORT=4040